<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&family=Shippori+Mincho:wght@700&family=Orbitron:wght@700&display=swap" rel="stylesheet">
    <style>
        /* KorDaiテーマ：サウンドウェーブ・ダーク・シアン */
        body { font-family: "Zen Kaku Gothic New", sans-serif; margin: 0; background-color: #0a0a0a; color: #e0e0e0; line-height: 1.8; }
        header { text-align: center; padding: 20px; background: #000; border-bottom: 2px solid #00bcd4; position: relative; }
        .back-home { position: absolute; left: 20px; top: 30px; text-decoration: none; color: #00bcd4; font-weight: bold; font-family: 'Orbitron', sans-serif; }
        
        .container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }

        /* ヒーローエリア（特大画像） */
        .hero-banner {
            width: 100%;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0, 188, 212, 0.3);
            margin-bottom: 40px;
            border: 1px solid #333;
        }

        h1 { font-family: 'Orbitron', sans-serif; color: #fff; margin: 0; letter-spacing: 2px; }
        h2 { 
            text-align: center; 
            font-size: 1.8rem; 
            margin-top: 60px; 
            margin-bottom: 30px; 
            color: #00bcd4; 
            border-bottom: 1px solid #333; 
            padding-bottom: 10px; 
            font-family: 'Orbitron', sans-serif;
        }
        
        h3 {
            color: #fff;
            border-left: 4px solid #00bcd4;
            padding-left: 15px;
            margin-top: 40px;
            margin-bottom: 20px;
        }

        /* プロフィール */
        .profile-box { background: #151515; padding: 30px; border-radius: 8px; border-left: 5px solid #00bcd4; box-shadow: 0 4px 10px rgba(0,0,0,0.5); }
        .profile-name { font-size: 1.5rem; font-weight: bold; color: #fff; margin-top: 0; }
        .profile-role { color: #00bcd4; font-family: 'Orbitron', sans-serif; margin-left: 10px; font-size: 1rem; }
        
        /* 実績リスト */
        .award-list { list-style: none; padding: 0; margin-top: 20px; }
        .award-list li { margin-bottom: 10px; padding-left: 20px; position: relative; color: #ccc; }
        .award-list li::before { content: "🏆"; position: absolute; left: 0; top: 2px; font-size: 0.8rem; }
        .award-title { font-weight: bold; color: #fff; margin-right: 10px; }

        /* 利用規約ボックス */
        .terms-box {
            background: #222;
            padding: 20px;
            border-radius: 8px;
            border: 1px dashed #666;
            margin-bottom: 30px;
            font-size: 0.9rem;
        }
        .terms-title { color: #00bcd4; display: block; margin-bottom: 10px; font-weight: bold; font-size: 1.1rem; }
        .terms-list { list-style: none; padding: 0; margin: 0; color: #ccc; }
        .terms-list li { margin-bottom: 5px; }

        /* BGMプレイヤー */
        .audio-card {
            background: #1a1a1a;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            border: 1px solid #333;
            transition: 0.3s;
        }
        .audio-card:hover { border-color: #00bcd4; box-shadow: 0 0 10px rgba(0, 188, 212, 0.1); }
        .audio-info { flex: 1; min-width: 200px; }
        .audio-title { font-weight: bold; color: #fff; display: block; }
        .audio-format { font-size: 0.75rem; color: #888; background: #222; padding: 2px 6px; border-radius: 4px; margin-left: 5px; }
        .audio-player { flex: 2; min-width: 250px; display: flex; align-items: center; gap: 10px; }
        audio { width: 100%; height: 30px; outline: none; }
        
        .download-link {
            color: #00bcd4;
            text-decoration: none;
            font-size: 1.2rem;
            padding: 5px 10px;
            border: 1px solid #00bcd4;
            border-radius: 4px;
            transition: 0.3s;
        }
        .download-link:hover { background: #00bcd4; color: #000; }

        /* BOOTHボタン・販売エリア */
        .shop-item {
            background: linear-gradient(135deg, #1a1a1a 0%, #222 100%);
            padding: 30px;
            border-radius: 8px;
            border: 1px solid #333;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 20px;
        }
        .shop-title { font-size: 1.5rem; font-weight: bold; color: #fff; margin-bottom: 10px; }
        .shop-desc { color: #aaa; margin-bottom: 20px; font-size: 0.9rem; }
        
        .booth-btn {
            display: inline-block;
            background: #fc4d50; /* BOOTHカラー */
            color: #fff;
            padding: 15px 50px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.2rem;
            transition: 0.3s;
            margin-top: 20px;
            box-shadow: 0 4px 15px rgba(252, 77, 80, 0.3);
        }
        .booth-btn:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(252, 77, 80, 0.6); }

        /* 料金表 */
        .price-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        
        /* リンクタグに変更（クリックでメール起動） */
        a.price-item {
            display: block;
            text-decoration: none;
            color: inherit;
            background: #151515;
            padding: 25px;
            border: 1px solid #333;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
            position: relative;
            overflow: hidden;
        }
        a.price-item:hover { transform: translateY(-5px); border-color: #00bcd4; background: #1a1a1a; }
        a.price-item::before { content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #00bcd4; }
        .price-name { font-weight: bold; color: #fff; font-size: 1.1rem; display: block; margin-bottom: 5px; }
        .price-val { font-weight: bold; color: #00bcd4; font-size: 1.2rem; display: block; margin-bottom: 10px; }
        .price-desc { font-size: 0.85rem; color: #aaa; }
        
        .contact-btn {
            display: inline-block;
            background: linear-gradient(90deg, #00bcd4, #008ba3);
            color: #000;
            padding: 15px 60px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.2rem;
            margin-top: 40px;
            box-shadow: 0 0 20px rgba(0, 188, 212, 0.4);
            transition: 0.3s;
        }
        .contact-btn:hover { transform: scale(1.05); box-shadow: 0 0 30px rgba(0, 188, 212, 0.6); color: #fff; }
        .click-hint { font-size: 0.8rem; color: #00bcd4; margin-top: 15px; text-align: right; }
    </style>
</head>
<body>

    <header>
        <a href="/portfolio" class="back-home">← PORTAL</a>
        <h1>DJ KorDai PORTFOLIO</h1>
        <div style="color:#aaa; font-family:'Orbitron', sans-serif;">Sound Director / Composer</div>
    </header>

    <div class="container">
        
        <!-- かっこいい画像 -->
        <img src="/images/kordai_banner.jpg" alt="DJ KorDai Main Visual" class="hero-banner">

        <section class="profile-box">
            <div class="profile-name">DJ KorDai <span class="profile-role">Sound Director</span></div>
            <p>
                2026年1月よりチーム「羽根いろの記憶」に正式加入。<br>
                幅広く楽曲を手掛け、「水と無重量」を感じさせる美麗で透明感のあるサウンドを得意とする。<br>
                ゲームの世界観を深めるBGM制作、SE作成、マスタリングまで、音響周りを一手に担うサウンドディレクター。
            </p>
            <div style="margin-top:20px; border-top:1px solid #333; padding-top:10px;">
                <strong style="color:#00bcd4;">【受賞歴・実績】</strong>
                <ul class="award-list">
                    <li><span class="award-title">ChainBeeT 楽曲公募受賞</span> midnight operation.exe</li>
                    <li><span class="award-title">第一回 WEBEAT MANIA 楽曲公募受賞</span> （未公開曲）</li>
                    <li><span class="award-title">KeyBox 楽曲公募受賞</span> （４曲未公開曲）</li>
                    <li><span class="award-title">BEATAIMR !! 楽曲公募受賞</span> C4</li>
                    <li><span class="award-title">DanceRail3 楽曲採用</span> Lifegazer</li>
                    <li>自作音ゲー「Colorful Beat」運営 / 音楽レーベル「Techcore crew」オーナー</li>
                </ul>
            </div>
        </section>

        <!-- 制作実績・サンプル（試聴のみ / OGG） -->
        <h2>WORKS & SAMPLES / 制作実績</h2>
        <p style="text-align:center; font-size:0.9rem; color:#aaa; margin-bottom:20px;">
            ※ サンプル試聴のみ（<strong style="color:#ff4d4d;">ダウンロード不可・複製禁止</strong>）
        </p>

        <h3>『夢見草の夜、君と』楽曲</h3>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">タイトル曲</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/yumemiso_title.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">日常シーン</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/yumemiso_daily.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">夢の中</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/yumemiso_dream.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">伊織のテーマ</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/yumemiso_iori.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">弦真のテーマ</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/yumemiso_genma.ogg"></audio>
            </div>
        </div>

        <h3>『羽根いろ物語』楽曲</h3>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">タイトル</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/haneiro_title.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">街</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/haneiro_town.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">森</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/haneiro_forest.ogg"></audio>
            </div>
        </div>
        <div class="audio-card">
            <div class="audio-info"><span class="audio-title">山</span></div>
            <div class="audio-player">
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/haneiro_mountain.ogg"></audio>
            </div>
        </div>


        <h2>FREE BGM / フリー素材</h2>
        
        <!-- 利用規約エリア -->
        <div class="terms-box">
            <strong class="terms-title">【利用規約】</strong>
            <ul class="terms-list">
                <li>✅ 商用利用可</li>
                <li>🚫 二次配布禁止 / 自作発言禁止</li>
                <li>🚫 公序良俗に反する使用を固く禁じます</li>
                <li>⚠️ 著作権はDJ KorDaiに依存します</li>
                <li style="margin-top:10px; color:#fff;">
                    使用の際はクレジット表記して頂けると嬉しいです。<br>
                    <span style="color:#00bcd4;">(例: 音楽: DJ KorDai)</span>
                </li>
            </ul>
        </div>
        
        <p style="text-align:center; font-size:0.9rem; color:#aaa; margin-bottom:20px;">
            ※ 以下の楽曲はダウンロード可能です
        </p>
        
        <div class="audio-card">
            <div class="audio-info">
                <span class="audio-title">熱波溢れる熱戦<span class="audio-format">MP3</span></span>
            </div>
            <div class="audio-player">
                <!-- フリー素材: mp3 -->
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/neppa.mp3"></audio>
                <a href="/audio/neppa.mp3" download="熱波溢れる熱戦.mp3" class="download-link" title="ダウンロード">⬇</a>
            </div>
        </div>

        <div class="audio-card">
            <div class="audio-info">
                <span class="audio-title">夏深し、時に蝉時雨<span class="audio-format">WAV</span></span>
            </div>
            <div class="audio-player">
                <!-- フリー素材: wav -->
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/semishigure.wav"></audio>
                <a href="/audio/semishigure.wav" download="夏深し、時に蝉時雨.wav" class="download-link" title="ダウンロード">⬇</a>
            </div>
        </div>

        <div class="audio-card">
            <div class="audio-info">
                <span class="audio-title">旅路、時に遭遇<span class="audio-format">WAV</span></span>
            </div>
            <div class="audio-player">
                <!-- フリー素材: wav -->
                <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/tabiji.wav"></audio>
                <a href="/audio/tabiji.wav" download="旅路、時に遭遇.wav" class="download-link" title="ダウンロード">⬇</a>
            </div>
        </div>

        <h2>SHOP / 販売・高音質素材</h2>
        
        <div class="shop-item">
            <div class="shop-title">Hype Flex (製品版)</div>
            <p class="shop-desc">
                高音質WAV収録。美麗で力強い、本気のサウンド。<br>
                まずは以下のDEMO版でご試聴ください。
            </p>
            
            <div class="audio-card" style="width:100%; max-width:600px; box-shadow:none; background:#111;">
                <div class="audio-info" style="text-align:left;">
                    <span class="audio-title">Hype Flex DEMO<span class="audio-format">MP3/試聴用</span></span>
                </div>
                <div class="audio-player">
                    <!-- デモ版: mp3 -->
                    <audio controls controlsList="nodownload" oncontextmenu="return false;" src="/audio/hype_flex_demo.mp3"></audio>
                </div>
            </div>

            <a href="https://haneironokioku.booth.pm/items/7915059" target="_blank" class="booth-btn">🛒 BOOTHで購入する</a>
        </div>

        <h2>PRICE LIST / 制作依頼</h2>
        <p style="text-align:center; font-size:0.9rem; color:#aaa; margin-bottom:20px;">
            ※クリックするとメールソフトが起動します
        </p>
        <div class="price-list">
            <!-- リンクタグに戻しました -->
            <a href="mailto:kouyan16ss2s@gmail.com?subject=通常BGM制作の依頼" class="price-item">
                <span class="price-name">通常料金1曲</span>
                <span class="price-val">15,000円</span>
                <div class="price-desc">
                    ゲーム・配信用BGMなど。<br>2分程度 / ループ処理済みも可。
                </div>
                <div class="click-hint">✉ 相談する</div>
            </a>

            <a href="mailto:kouyan16ss2s@gmail.com?subject=フルコーラス曲制作の依頼" class="price-item">
                <span class="price-name">フルコーラス曲</span>
                <span class="price-val">25,000円</span>
                <div class="price-desc">
                    3～4分のBGM等インスト曲。<br>メインテーマやイベントシーンに最適。
                </div>
                <div class="click-hint">✉ 相談する</div>
            </a>

            <a href="mailto:kouyan16ss2s@gmail.com?subject=編曲の依頼" class="price-item">
                <span class="price-name">編曲</span>
                <span class="price-val">10,000円</span>
                <div class="price-desc">
                    既存楽曲のアレンジ。<br>楽器追加や雰囲気の変更など。
                </div>
                <div class="click-hint">✉ 相談する</div>
            </a>

            <a href="mailto:kouyan16ss2s@gmail.com?subject=ボーカル曲制作の依頼" class="price-item">
                <span class="price-name">ボーカル曲</span>
                <span class="price-val">25,000円〜</span>
                <div class="price-desc">
                    歌もの楽曲制作。<br>
                    <span style="color:#00bcd4;">※歌い手手配をご希望の場合 +10,000円</span>
                </div>
                <div class="click-hint">✉ 相談する</div>
            </a>
        </div>

        <div style="text-align:center;">
            <a href="mailto:kouyan16ss2s@gmail.com?subject=DJ KorDaiへの楽曲依頼について" class="contact-btn">📩 楽曲制作を依頼する</a>
        </div>
        
        <div style="text-align:center; margin-top:40px;">
            <a href="/portfolio" style="color:#666; text-decoration:none; border-bottom:1px solid #333;">← ポートフォリオ選択へ戻る</a>
        </div>

    </div>
</body>
</html>